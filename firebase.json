{
  "hosting": {
    "target": "prod",
    "public": "public",
    "redirects": [
      {
        "source": "/",
        "destination": "/subscribe",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "aero-india-tracker",
          "region": "asia-southeast2"
        }
      }
    ]
  }
}
