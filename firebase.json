{
  "hosting": [
    {
      "target": "dev-custom",
      "public": "public",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "aero_india_tracker",
            "region": "asia-southeast2"
          }
        }
      ]
    },
    {
      "target": "prod",
      "public": "public",
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "aero_india_tracker_prod",
            "region": "asia-southeast2"
          }
        }
      ]
    }
  ]
}
